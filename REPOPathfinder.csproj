<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>REPOPathfinder</AssemblyName>
    <RootNamespace>REPOPathfinder</RootNamespace>
    <Version>0.7.2</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <!-- Override on the cmd line: dotnet build -p:REPOPath="D:\SteamLibrary\steamapps\common\REPO" -->
    <REPOPath Condition="'$(REPOPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\REPO</REPOPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.21" IncludeAssets="compile" />
    <PackageReference Include="HarmonyX" Version="2.10.*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(REPOPath)\REPO_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Photon3Unity3D" Condition="Exists('$(REPOPath)\REPO_Data\Managed\Photon3Unity3D.dll')">
      <HintPath>$(REPOPath)\REPO_Data\Managed\Photon3Unity3D.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonUnityNetworking" Condition="Exists('$(REPOPath)\REPO_Data\Managed\PhotonUnityNetworking.dll')">
      <HintPath>$(REPOPath)\REPO_Data\Managed\PhotonUnityNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ThunderstorePack" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackDir>$(MSBuildProjectDirectory)\dist\REPOPathfinder</PackDir>
    </PropertyGroup>
    <RemoveDir Directories="$(PackDir)" />
    <MakeDir Directories="$(PackDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackDir)" />
    <Copy SourceFiles="manifest.json;README.md;icon.png" DestinationFolder="$(PackDir)" Condition="Exists('icon.png')" />
    <Copy SourceFiles="manifest.json;README.md" DestinationFolder="$(PackDir)" Condition="!Exists('icon.png')" />
    <ZipDirectory SourceDirectory="$(PackDir)" DestinationFile="$(MSBuildProjectDirectory)\dist\REPOPathfinder-$(Version).zip" Overwrite="true" />
  </Target>

</Project>
