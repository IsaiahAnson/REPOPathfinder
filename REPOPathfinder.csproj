<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The version is written in one place: version_number in manifest.json. -->
    <ManifestPath>$(MSBuildThisFileDirectory)manifest.json</ManifestPath>
    <ManifestText>$([System.IO.File]::ReadAllText('$(ManifestPath)'))</ManifestText>
    <ManifestVersion>$([System.Text.RegularExpressions.Regex]::Match($(ManifestText), '(?&lt;="version_number"\s*:\s*")\d+\.\d+\.\d+').Value)</ManifestVersion>
    <PluginVersionFile>$(MSBuildThisFileDirectory)obj/PluginVersion.g.cs</PluginVersionFile>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>REPOPathfinder</AssemblyName>
    <RootNamespace>REPOPathfinder</RootNamespace>
    <Version>$(ManifestVersion)</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <!-- Override on the cmd line: dotnet build -p:REPOPath="D:\SteamLibrary\steamapps\common\REPO" -->
    <REPOPath Condition="'$(REPOPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\REPO</REPOPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.21" IncludeAssets="compile" />
    <PackageReference Include="HarmonyX" Version="2.10.*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(REPOPath)\REPO_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Photon3Unity3D" Condition="Exists('$(REPOPath)\REPO_Data\Managed\Photon3Unity3D.dll')">
      <HintPath>$(REPOPath)\REPO_Data\Managed\Photon3Unity3D.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonUnityNetworking" Condition="Exists('$(REPOPath)\REPO_Data\Managed\PhotonUnityNetworking.dll')">
      <HintPath>$(REPOPath)\REPO_Data\Managed\PhotonUnityNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Writes PluginVersion.Value from manifest.json, so the [BepInPlugin] version matches the package. -->
  <Target Name="GeneratePluginVersion" BeforeTargets="CoreCompile">
    <Error Condition="'$(ManifestVersion)' == ''" Text="No version_number (x.y.z) found in $(ManifestPath)." />
    <WriteLinesToFile File="$(PluginVersionFile)" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="// Generated from manifest.json by REPOPathfinder.csproj. Do not edit.;namespace REPOPathfinder { internal static class PluginVersion { public const string Value = &quot;$(ManifestVersion)&quot;%3B } }" />
    <ItemGroup>
      <Compile Remove="$(PluginVersionFile)" />
      <Compile Include="$(PluginVersionFile)" />
    </ItemGroup>
  </Target>

  <!-- The Thunderstore zip is built by tools/make_package.py, which leaves the GitHub-only parts out of the README. -->

</Project>
